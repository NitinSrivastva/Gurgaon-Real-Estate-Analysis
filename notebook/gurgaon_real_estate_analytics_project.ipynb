# Filtered visualization after removing extreme area outliers

filtered_df = df[df["area"] < 10000]

plt.figure(figsize=(10,6))

sns.scatterplot(
    x=filtered_df["area"],
    y=filtered_df["price_in_crore"]
)

plt.title("Area vs Price (Filtered)")

